# -----------------------------------------------------------------------------
# Firebase Platform Configuration
# Assigned Firebase Project ID: travi-app-23th10
#
# ARCHITECTURAL RULES & SECURITY POLICY:
# 1. The frontend operates completely in isolated offline demo mode when credentials
#    are omitted or empty. Zero runtime crashes.
# 2. DO NOT add placeholder or fake keys (e.g., 'AIzaSyFakeKey...'). They will cause
#    failed handshake errors with Firebase Auth and Firestore.
# 3. When connecting live backend services:
#    - Copy verified credentials from Firebase Console (Project Settings > General > Web apps).
#    - Deploy firestore.rules and storage.rules to enforce strict user-scoped isolation (/users/{userId}/*).
#    - Verify Firebase Auth providers (Google, Email/Password) are enabled in Console.
# 4. Local demo data in demoStore is NOT silently synced to remote databases.
# -----------------------------------------------------------------------------
VITE_FIREBASE_PROJECT_ID="travi-app-23th10"
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="travi-app-23th10.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="travi-app-23th10.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
